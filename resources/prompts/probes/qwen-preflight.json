{
  "schema_version": 1,
  "startup_timeout_seconds": 300,
  "text_prompt": "只返回一个 JSON 对象，并将 status 设为 ok。",
  "vision_prompt": "按输入图像的顺序判断每张图中角色的手臂姿势。poses 的每一项只能使用 hands_in_pockets 或 arms_at_sides，并将 status 设为 ok。",
  "image_paths": [
    "assets/pet/idle.png",
    "assets/pet/normal.png"
  ],
  "expected_poses": [
    "hands_in_pockets",
    "arms_at_sides"
  ],
  "text_response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "const": "ok"
      }
    },
    "required": [
      "status"
    ],
    "additionalProperties": false
  },
  "vision_response_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "const": "ok"
      },
      "poses": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "hands_in_pockets",
            "arms_at_sides"
          ]
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "required": [
      "status",
      "poses"
    ],
    "additionalProperties": false
  }
}
